{color:#ded4c9;font-size:16.5px;max-width:46em}\n.hero-sign{margin-top:34px;font-size:13px;letter-spacing:.22em;color:var(--muted)}\n.hero-sign b{color:var(--mint);font-weight:600}\n\n/* ---------- 通用区块 ---------- */\nsection{padding:76px 0}\n.sec-head{margin-bottom:40px}\n.sec-head .kicker{display:inline-block;font-size:11.5px;letter-spacing:.3em;color:var(--mint-deep);border-left:3px solid var(--mint-deep);padding-left:10px;margin-bottom:14px}\n.sec-head h2{font-size:clamp(23px,3vw,30px);color:var(--brown)}\n.sec-head p{margin-top:12px;color:var(--muted);max-width:56em;font-size:15px}\n\n/* ---------- 使用说明 ---------- */\n.howto{background:var(--ivory-2)}\n.steps{display:grid;gap:20px}\n.step{background:#fff;border-radius:22px;padding:28px 30px;box-shadow:0 12px 30px -18px rgba(46,31,24,.35);display:grid;grid-template-columns:64px minmax(0,1fr);gap:22px;align-items:start}\n.step-num{font-size:30px;font-weight:800;color:var(--mint-deep);line-height:1;padding-top:4px}\n.step h3{font-size:17px;color:var(--brown);margin-bottom:8px}\n.step p{font-size:14.5px;color:var(--brown-2);margin:0}\n\n/* ---------- 套餐 ---------- */\n.plans{background:var(--ivory)}\n.plan{background:#fff;border-radius:26px;padding:34px 34px 30px;box-shadow:0 18px 42px -24px rgba(46,31,24,.45);margin-bottom:26px;border:1px solid rgba(46,31,24,.06)}\n.plan.featured{background:var(--brown);color:var(--ivory);box-shadow:0 24px 50px -22px rgba(46,31,24,.6);border-color:var(--brown)}\n.plan-head{display:flex;flex-wrap:wrap;gap:16px 26px;align-items:flex-end;justify-content:space-between;padding-bottom:22px;border-bottom:1px dashed rgba(46,31,24,.18)}\n.plan.featured .plan-head{border-bottom-color:rgba(169,229,207,.3)}\n.plan-name{font-size:21px;font-weight:700;color:var(--brown)}\n.plan.featured .plan-name{color:#fff}\n.plan-name small{display:inline-block;font-size:11px;letter-spacing:.16em;background:var(--mint);color:var(--brown);padding:3px 10px;border-radius:999px;margin-left:12px;vertical-align:2px;font-weight:600}\n.price{text-align:right}\n.price .num{font-size:30px;font-weight:800;color:var(--brown);letter-spacing:-.01em}\n.plan.featured .price .num{color:var(--mint)}\n.price .per{font-size:13px;color:var(--muted);margin-left:2px}\n.price .annual{display:block;font-size:12.5px;color:var(--muted);margin-top:2px}\n.plan.featured .price .annual{color:#b9a99b}\n.plan ul{list-style:none;margin:22px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 28px}\n.plan li{font-size:14.5px;color:var(--brown-2);padding-left:20px;position:relative}\n.plan.featured li{color:#ded4c9}\n.plan li::before{content:\"\";position:absolute;left:0;top:9px;width:7px;height:7px;border-radius:2px;background:var(--mint-deep)}\n.plan.featured li::before{background:var(--mint)}\n.plans-note{font-size:13px;color:var(--muted);border-top:1px solid rgba(46,31,24,.12);padding-top:18px}\n\n/* ---------- 客户端 ---------- */\n.clients{background:var(--ivory-2)}\n.client-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px}\n.client{background:#fff;border-radius:20px;padding:26px 26px 24px;box-shadow:0 12px 30px -20px rgba(46,31,24,.4)}\n.client h3{font-size:16px;color:var(--brown);margin-bottom:8px}\n.client p{font-size:14px;color:var(--muted);margin:0 0 14px}\n.client .tag{display:inline-block;font-size:12px;letter-spacing:.06em;color:var(--brown-2);background:var(--mint);border-radius:6px;padding:3px 10px}\n.client .tag.alt{background:var(--ivory-2);color:var(--muted)}\n\n/* ---------- FAQ ---------- */\n.faq{background:var(--ivory)}\n.faq details{background:#fff;border-radius:16px;padding:0;margin-bottom:14px;box-shadow:0 10px 26px -22px rgba(46,31,24,.5);border:1px solid rgba(46,31,24,.07);overflow:hidden}\n.faq summary{cursor:pointer;list-style:none;padding:20px 26px;font-size:15.5px;font-weight:600;color:var(--brown);display:flex;gap:16px;align-items:flex-start;position:relative;padding-right:52px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:\"+\";position:absolute;right:26px;top:50%;transform:translateY(-50%);font-size:20px;font-weight:400;color:var(--mint-deep);line-height:1}\n.faq details[open] summary::after{content:\"–\"}\n.faq summary .q{color:var(--mint-deep);font-weight:800;margin-right:2px}\n.faq .a{padding:0 26px 22px 26px;font-size:14.5px;color:var(--brown-2);max-width:60em}\n.faq .a p{margin:0 0 .7em}\n.faq .a p:last-child{margin:0}\n\n/* ---------- 页脚 ---------- */\nfooter{background:var(--brown);color:var(--muted);padding:46px 0 40px;font-size:13px}\nfooter .frow{display:flex;flex-wrap:wrap;gap:18px 40px;justify-content:space-between;align-items:baseline}\nfooter b{color:var(--mint);letter-spacing:.3em;font-weight:600}\nfooter a{text-decoration:none;color:var(--ivory-2)}\nfooter a:hover{color:var(--mint)}\n\n@media (max-width:760px){\n  .hero{padding:44px 0 52px}\n  .hero-body{grid-template-columns:1fr;gap:26px;padding-top:34px}\n  .hero-side{display:flex;flex-wrap:wrap;gap:6px 22px;line-height:1.9}\n  .hero-side strong{margin:0}\n  section{padding:56px 0}\n  .step{grid-template-columns:1fr;gap:10px;padding:24px 22px}\n  .step-num{font-size:22px}\n  .plan{padding:26px 22px 24px;border-radius:20px}\n  .price{text-align:left}\n  .plan ul{grid-template-columns:1fr}\n  .faq summary{padding:18px 46px 18px 20px;font-size:15px}\n  .faq summary::after{right:20px}\n  .faq .a{padding:0 20px 20px}\n}\n</style><main>\n\n  <header class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div class=\"brandmark\">qimiao<span>一份网络使用说明</span></div>\n        <nav class=\"anchors\" aria-label=\"页面内跳转\">\n          <a href=\"#howto\">怎么开始</a>\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#faq\">常见问题</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-body\">\n        <div class=\"hero-side\">\n          <div><strong>版本</strong>页面手册 v1</div>\n          <div><strong>结构</strong>说明 · 套餐 · 客户端 · 问答</div>\n          <div><strong>写法</strong>短句，逐条交代</div>\n          <div><strong>更新</strong>随页面同步</div>\n        </div>\n\n        <div class=\"hero-main\">\n          <h1>先别急着买，<em>qimiao</em> 想让你先读完这一页。</h1>\n          <p>大多数服务页的第一屏都在催你做决定。这页反过来：先把该说的说清楚，套餐有什么、没有什么，客户端在哪一步用、哪一步会卡，都摊开写。看完如果你觉得不需要，那也正常。</p>\n          <p>qimiao 的做法很简单——按流量和同时在线设备数分档，不搞隐藏条款，不把基础功能说成增值功能。三档套餐在下面依次排列，价格和权益都写在卡片上，愿意花三分钟就能读完。</p>\n          <p>接下来你会看到四块内容：使用说明的四个步骤、三档套餐、客户端的分平台说明，以及一组按主题折叠的常见问题。想直接看哪块，就点上面那排锚点。</p>\n          <div class=\"hero-sign\">阅读时间约 <b>4 分钟</b> · 无需注册即可查看全部内容</div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <section class=\"howto\" id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">使用说明</span>\n        <h2>四步走完，不绕路</h2>\n        <p>从挑套餐到日常使用，只有四件事需要你判断。顺序按实际操作来，不是按营销逻辑来。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">01</div>\n          <div>\n            <h3>先算你的月用量</h3>\n            <p>把过去一个月的流量大致估一遍：看视频多还是看文档多，几台设备一起用。基础版每月 100GB、支持 3 台设备，够轻度使用者；如果你经常开高清视频或多人共用，直接看旗舰版的 300GB 与 5 台设备。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">02</div>\n          <div>\n            <h3>选月付还是年付</h3>\n            <p>月付适合先试一个月。年付在同档位下总价更低，基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。如果你确定要用满一年，年付更划算；不确定就先月付。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">03</div>\n          <div>\n            <h3>挑一个客户端装好</h3>\n            <p>桌面端、移动端都有对应客户端，按你的系统选一个即可。安装后使用套餐提供的凭据登录，这一步决定你后面顺不顺。具体平台见下方客户端区块。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">04</div>\n          <div>\n            <h3>用一周，再决定要不要升档</h3>\n            <p>先把当前档位用满一周，看流量走得快不快、设备够不够。流量吃紧或设备数超了，再考虑升档；反之不必提前买更贵的。团队版适合 20 台设备与定制路由需求的场景。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">套餐</span>\n        <h2>三档，从轻到重</h2>\n        <p>按流量和同时在线设备数分档。价格、年付价与权益全部列在卡片上，没有另附条件。</p>\n      </div>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <div class=\"plan-name\">基础版</div>\n          <div class=\"price\">\n            <span class=\"num\">¥15</span><span class=\"per\">/月</span>\n            <span class=\"annual\">按年付 ¥150/年</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan featured\">\n        <div class=\"plan-head\">\n          <div class=\"plan-name\">旗舰版<small>多数人选择</small></div>\n          <div class=\"price\">\n            <span class=\"num\">¥35</span><span class=\"per\">/月</span>\n            <span class=\"annual\">按年付 ¥350/年</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <div class=\"plan-name\">团队版</div>\n          <div class=\"price\">\n            <span class=\"num\">¥85</span><span class=\"per\">/月</span>\n            <span class=\"annual\">按年付 ¥850/年</span>\n          </div>\n        </div>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n\n      <p class=\"plans-note\">年度价格按对应档位一次性结算。设备数指同时在线数量，超出时需升档或减少在线设备。</p>\n    </div>\n  </section>\n\n  <section class=\"clients\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">客户端</span>\n        <h2>按系统选，装一个就够</h2>\n        <p>不同平台有各自的客户端，选你正在用的系统即可。下载入口以页面实际提供的为准，本页不代填下载地址。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <div class=\"client\">\n          <h3>桌面端 · Windows / macOS</h3>\n          <p>适合办公与家用主力机，支持托盘常驻，切换线路在菜单里完成。</p>\n          <span class=\"tag\">下载地址见页内入口</span>\n        </div>\n        <div class=\"client\">\n          <h3>移动端 · iOS / Android</h3>\n          <p>出门在外的主用方式。安装后用套餐凭据登录，注意同时在线设备数上限。</p>\n          <span class=\"tag\">下载地址见页内入口</span>\n        </div>\n        <div class=\"client\">\n          <h3>路由器 / 其他设备</h3>\n          <p>多设备共用场景可考虑路由侧配置。这部分涉及具体型号，建议先看常见问题。</p>\n          <span class=\"tag alt\">按需配置</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">常见问题</span>\n        <h2>先看这里，再决定问不问</h2>\n        <p>以下按主题分组，点标题展开。答案写得直白，没有绕圈子的部分。</p>\n      </div>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>三档套餐最实质的区别是什么？</summary>\n        <div class=\"a\">\n          <p>三点：每月流量、同时在线设备数、节点类型。基础版 100GB 与 3 台设备；旗舰版 300GB、5 台设备，并额外提供全节点原生流媒体解锁与 IPLC 专线游戏加速优化；团队版 1000GB、20 台设备，含 VIP 专属高带宽节点与企业定制路由。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>月付和年付能随时切换吗？</summary>\n        <div class=\"a\">\n          <p>可以先月付一个月，觉得合适再改年付。年付在同档位下总价更低：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。具体切换方式以页内入口说明为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>同时在线设备数超了会怎样？</summary>\n        <div class=\"a\">\n          <p>同时在线数量按套餐上限计算，超出后需要减少在线设备，或者升到更高一档。手机、平板、电脑都算在内，建议在购买前先数一遍常用的设备。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>流量用超了怎么处理？</summary>\n        <div class=\"a\">\n          <p>先看是偶发峰值还是常态。偶发可以把高清视频调低一档；常态说明档位选小了，考虑升档。各档位每月流量基础版 100GB、旗舰版 300GB、团队版 1000GB。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>客户端在哪里下载？</summary>\n        <div class=\"a\">\n          <p>本页不代填下载地址，客户端分桌面端、移动端与其他设备三类，实际下载入口以页面提供的为准。安装后使用套餐凭据登录即可。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>团队版适合什么样的使用场景？</summary>\n        <div class=\"a\">\n          <p>适合多人共用、设备数量多、需要定制路由的场景。它提供 20 台设备同时在线、1000GB 月流量、VIP 专属高带宽节点与专属客户经理服务。如果只是个人使用，旗舰版通常已经够用。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary><span class=\"q\">Q.</span>有问题找谁？</summary>\n        <div class=\"a\">\n          <p>旗舰版含 7×24 优先工单支持，团队版另有专属客户经理服务。基础版按常规工单渠道处理。提问时把设备系统、客户端版本和现象写清楚，处理会更快。</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap frow\">\n    <div><b>qimiao</b> · 一份网络使用说明</div>\n    <div>\n      <a href=\"#howto\">怎么开始</a> ·\n      <a href=\"#plans\">套餐</a> ·\n      <a href=\"#clients\">客户端</a> ·\n      <a href=\"#faq\">常见问题</a>\n    </div>\n    <div>页面内容以实际提供的服务说明为准</div>\n  </div>\n</footer>",
